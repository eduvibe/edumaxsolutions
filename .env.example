# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets for Bravo CBT online payments.
# Copy to .env.local for local work. NEVER commit real values, and NEVER prefix these
# with NEXT_PUBLIC_. Vercel: set them per environment (Preview / Production) in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Paystack. Preview: sk_test_...  Production: sk_live_... (the app refuses mismatches on Vercel).
PAYSTACK_SECRET_KEY=

# Turso (libSQL). Use SEPARATE databases for Preview and Production.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Bravo CBT <no-reply@edumaxsolutions.ng>

# Activation key signing (PKCS#8 PEM, single line with \n escapes is accepted).
# Production only. Never set this in Preview, because preview payments could then mint valid keys.
# It must match the committed public key in src/lib/bravo/activation-key.ts.
BRAVO_ACTIVATION_PRIVATE_KEY=

# Optional. Public origin used in Paystack callback URLs. Defaults to https://www.edumaxsolutions.com.ng
BRAVO_SITE_URL=

# Edition year recorded on each new order (four digits, e.g. 2026). Order creation fails while unset.
BRAVO_EDITION_YEAR=
